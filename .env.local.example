NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Agente local de impressão de etiquetas (roda no computador da loja que tem
# a Goldensky conectada). Só precisa mudar se a porta padrão (9100) for
# alterada na instalação do agente — veja backend/scripts/goldensky-agente.py
NEXT_PUBLIC_GOLDENSKY_AGENTE_URL=http://localhost:9100/imprimir-etiquetas

# Servidores STUN/TURN das chamadas de áudio/vídeo (JSON). Opcional: sem isto usa
# só STUN público do Google, que não atravessa algumas redes (4G/empresas). Para
# essas, informe um servidor TURN, por exemplo:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.seudominio.com:3478","username":"usuario","credential":"senha"}]
