NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Agente local de impressão de etiquetas (roda no computador da loja que tem a
# impressoras conectadas). Cupom não fiscal -> Goldensky 80mm; etiquetas de preço ->
# Elgin L42 Pro Full. A tela de etiquetas confirma a impressora pelo GET /status do agente. Só precisa mudar se a porta padrão (9100) for
# alterada na instalação do agente — veja backend/scripts/goldensky-agente.py
NEXT_PUBLIC_GOLDENSKY_AGENTE_URL=http://localhost:9100/imprimir-etiquetas

# Opcional: URLs do cupom não fiscal. Por padrão usam o mesmo agente (porta 9100):
#   venda -> http://localhost:9100/imprimir-cupom
#   troca -> http://localhost:9100/imprimir-cupom-troca (derivada da URL do cupom de venda)
# NEXT_PUBLIC_GOLDENSKY_CUPOM_URL=http://localhost:9100/imprimir-cupom
# NEXT_PUBLIC_GOLDENSKY_CUPOM_TROCA_URL=http://localhost:9100/imprimir-cupom-troca

# Servidores STUN/TURN das chamadas de áudio/vídeo (JSON). Opcional: sem isto usa
# só STUN público do Google, que não atravessa algumas redes (4G/empresas). Para
# essas, informe um servidor TURN, por exemplo:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.seudominio.com:3478","username":"usuario","credential":"senha"}]
